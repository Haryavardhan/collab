# Groq AI API Key for Career Guidance RAG Bot (free at https://console.groq.com)
GROK_API_KEY=gsk_your_groq_api_key_here

# JWT Secret Key for Session Authentication
JWT_SECRET_KEY=collabsphere-jwt-secret-key

# Database Connection (Defaults to SQLite if commented out)
# DATABASE_URL=postgresql://username:password@localhost:5432/collab_db

# Email SMTP Credentials (Optional - for reset password emails)
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_app_password

# Twilio SMS Credentials (Optional)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# Razorpay Payment Gateway (Test Mode - for Mentor Bookings)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
